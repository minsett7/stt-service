APP_NAME=burmese-stt-service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false

MAX_AUDIO_SIZE_MB=20
SUPPORTED_AUDIO_FORMATS=wav,mp3,m4a,webm
NORMALIZE_AUDIO=true
FFMPEG_BINARY=ffmpeg
NORMALIZED_SAMPLE_RATE=16000

# Microphone preprocessing (disable individual stages to benchmark them)
AUDIO_PREPROCESSING_ENABLED=true
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_TARGET_CHANNELS=1
AUDIO_MAX_DURATION_SECONDS=30
AUDIO_DC_OFFSET_REMOVAL_ENABLED=true
AUDIO_HIGH_PASS_ENABLED=true
AUDIO_HIGH_PASS_HZ=80
AUDIO_NOISE_SUPPRESSION_ENABLED=true
# V1 uses FFmpeg's mild afftdn filter; use none to disable it.
AUDIO_NOISE_SUPPRESSION_PROVIDER=ffmpeg_afftdn
AUDIO_NORMALIZATION_ENABLED=true
AUDIO_TARGET_PEAK_DBFS=-3
AUDIO_MAX_GAIN_DB=12
VAD_ENABLED=true
VAD_MIN_SPEECH_MS=300
VAD_SPEECH_PAD_MS=250
VAD_FRAME_MS=30
VAD_SPEECH_THRESHOLD_DBFS=-42
AUDIO_LOW_VOLUME_RMS_DBFS=-45
AUDIO_EXTREMELY_LOW_VOLUME_RMS_DBFS=-60
AUDIO_CLIPPING_THRESHOLD=0.99
AUDIO_MAX_CLIPPING_RATIO=0.02
AUDIO_MIN_SPEECH_RATIO=0.05
AUDIO_DEBUG_SAVE_INTERMEDIATE=false
AUDIO_DEBUG_DIRECTORY=debug-audio

ASR_MODEL=chuuhtetnaing/whisper-large-v3-myanmar
ASR_DEVICE=auto
ASR_DTYPE=auto

CORRECTION_ENABLED=true
CORRECTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORRECTION_TIMEOUT_SECONDS=45
REQUEST_TIMEOUT_SECONDS=900
MAX_CORRECTION_CHANGE_RATIO=0.45
